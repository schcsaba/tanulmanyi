# Production Environment Configuration

# Django Settings - CHANGE THESE VALUES!
SECRET_KEY=CHANGE-THIS-TO-A-VERY-SECURE-SECRET-KEY-IN-PRODUCTION
DEBUG=False
ALLOWED_HOST=yourdomain.com,localhost,0.0.0.0,127.0.0.1

# SSL Settings (enabled for production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Database Settings - CHANGE THESE VALUES!
DB_NAME=tanulmanyi_prod
DB_USER=tanulmanyi_prod_user
DB_PASSWORD=CHANGE-THIS-TO-A-SECURE-PASSWORD
DB_HOST=db
DB_ROOT_PASSWORD=CHANGE-THIS-TO-A-SECURE-ROOT-PASSWORD

# Production specific
DJANGO_LOG_LEVEL=INFO

# Additional production settings
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY